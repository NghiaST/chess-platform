# Backend environment variables — PRODUCTION
# Set all these in Render Dashboard → Service → Environment

# App
NODE_ENV=production
# PORT is auto-set by Render — do NOT set this manually

# Database — copy from Neon Dashboard → Connection String → Prisma
# Format: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# JWT — Render can auto-generate this (generateValue: true in render.yaml)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# CORS — set to your actual Vercel URL after deployment
FRONTEND_URL=https://your-chess-app.vercel.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
