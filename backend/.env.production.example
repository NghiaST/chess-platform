# Backend environment variables — PRODUCTION
# Set all these in Railway Dashboard → Project → Variables

# App
NODE_ENV=production
PORT=4000

# Database (Railway auto-injects DATABASE_URL when you add a Postgres plugin)
DATABASE_URL=postgresql://user:password@host:5432/railway

# JWT — CHANGE THIS to a long random string in production!
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# CORS — set to your actual Vercel URL after deployment
FRONTEND_URL=https://your-chess-app.vercel.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
